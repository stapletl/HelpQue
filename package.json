{
    "name": "-t",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "npx convex dev --once && concurrently -r npm:dev:web npm:dev:convex",
        "dev:web": "vite dev",
        "dev:ts": "tsc -b -w",
        "dev:convex": "npx convex dev",
        "build": "vite build && tsc --noEmit",
        "preview": "vite preview",
        "deploy": "npm run build && wrangler deploy",
        "cf-typegen": "wrangler types",
        "format": "prettier --write .",
        "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
    },
    "dependencies": {
        "@auth/core": "0.41.1",
        "@convex-dev/auth": "0.0.90",
        "@convex-dev/react-query": "^0.0.0-alpha.11",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-slot": "1.2.3",
        "@tanstack/react-query": "5.90.5",
        "@tanstack/react-router": "1.133.36",
        "@tanstack/react-router-with-query": "1.130.17",
        "@tanstack/react-start": "1.134.3",
        "@types/node": "24.9.2",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "convex": "1.28.0",
        "lucide-react": "0.548.0",
        "motion": "12.23.24",
        "next-themes": "0.4.6",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "sonner": "2.0.7",
        "tailwind-merge": "3.3.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.13.18",
        "@convex-dev/eslint-plugin": "1.0.0",
        "@tailwindcss/vite": "4.1.16",
        "@tanstack/eslint-config": "0.3.2",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@vitejs/plugin-react": "5.1.0",
        "concurrently": "9.2.1",
        "prettier": "3.6.2",
        "tailwindcss": "4.1.16",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vite": "7.1.12",
        "vite-tsconfig-paths": "5.1.4",
        "wrangler": "4.45.3"
    }
